# ==========================================
# CẤU HÌNH FIREBASE FIRESTORE CHO VERCEL & LOCAL
# ==========================================
# Hướng dẫn lấy các biến này (miễn phí 100%):
# 1. Truy cập https://console.firebase.google.com/
# 2. Tạo một project mới (hoặc chọn project có sẵn)
# 3. Vào mục Build > Firestore Database > Bấm "Create Database" (chọn chế độ test mode hoặc production mode)
# 4. Vào Project settings (Biểu tượng bánh răng) > General > cuộn xuống "Your apps" > Bấm tạo Web App (</>)
# 5. Copy các giá trị tương ứng vào dưới đây:

NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-football-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-football-app
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-football-app.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

